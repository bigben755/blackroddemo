# Backend shared-password gate
# Set real values only in the deployment environment, never in GitHub.
DEMO_ACCESS_PASSWORD=choose-a-shared-password
DEMO_SESSION_SECRET=replace-with-a-long-random-secret
CORS_ORIGINS=https://demo.blackrodnow.com

# Frontend only when API is hosted on another origin.
# If the deployment proxies /api to the backend on the same host, leave unset.
REACT_APP_BACKEND_URL=
